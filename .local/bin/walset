#!/bin/bash

WALL_DIR="$HOME/.config/wallpaper"
CWD="$(pwd)"

cd "$WALL_DIR" || exit 1
IFS=$'\n'

SELECTED_WALL=$(for a in *.jpg *.png *.jpeg; do
    echo -en "$a\0icon\x1f$a\n"
done | wofi -dmenu -p "Wallpaper")

if [ -n "$SELECTED_WALL" ]; then
    walset-backend "$WALL_DIR/$SELECTED_WALL"
fi

cd "$CWD" || exit 1

